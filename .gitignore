# ── Dependencias ──────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/

# ── Build ─────────────────────────────────────────────────────────────────────
frontend/dist/
frontend/.vite/

# ── Variables de entorno ───────────────────────────────────────────────────────
.env
.env.local
.env.production
backend/.env
frontend/.env

# ── Modelos de IA (se descargan automáticamente en el primer uso) ─────────────
# El directorio .cache en backend es generado por @imgly/background-removal-node
# Se preserva en el servidor entre deploys pero no se sube a git (~100-200 MB)
backend/.imgly/
backend/.cache/
**/.imgly-cache/
**/.cache/ort/

# ── Uploads temporales ────────────────────────────────────────────────────────
backend/uploads/
tmp/

# ── Sistema operativo ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*

# ── PM2 ───────────────────────────────────────────────────────────────────────
.pm2/
