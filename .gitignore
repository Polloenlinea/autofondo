# ── Dependencias ──────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/

# ── Build ─────────────────────────────────────────────────────────────────────
frontend/dist/
frontend/.vite/

# ── Variables de entorno ───────────────────────────────────────────────────────
.env
.env.local
.env.production
backend/.env
frontend/.env

# ── Modelos de IA ─────────────────────────────────────────────────────────────
# El modelo ONNX de @imgly viene bundleado en node_modules (ya cubierto arriba).
# Por las dudas, excluir directorios de caché legacy de versiones anteriores de @imgly.
backend/.imgly/
**/.imgly-cache/
# Modelos BiRefNet (.onnx) — pesan 214MB/972MB, superan el límite de GitHub.
# Se descargan en el servidor durante el deploy (ver scripts/download-models.sh).
backend/ml/*.onnx

# ── Uploads temporales ────────────────────────────────────────────────────────
backend/uploads/
tmp/

# ── Sistema operativo ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*

# ── PM2 ───────────────────────────────────────────────────────────────────────
.pm2/
