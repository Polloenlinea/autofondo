# ── AutoFondo — Variables de entorno del backend ──────────────────────────────
# Copiá este archivo a .env y completá los valores

# Puerto del servidor (en producción lo gestiona PM2/ecosystem.config.js)
PORT=8001

# Modo de ejecución: development | production
NODE_ENV=development

# Origen permitido para CORS en producción
# (en desarrollo se permite todo automáticamente)
ALLOWED_ORIGIN=https://autofondo.artificialmente.com
