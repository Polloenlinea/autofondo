# ── AutoFondo — Variables de entorno del backend ──────────────────────────────
# Copiá este archivo a .env y completá los valores

# Puerto del servidor (en producción lo gestiona PM2/ecosystem.config.js)
PORT=8001

# Modo de ejecución: development | production
NODE_ENV=development

# Origen permitido para CORS en producción
# (en desarrollo se permite todo automáticamente)
ALLOWED_ORIGIN=https://autofondo.artificialmente.com

# URI de MongoDB
# Opción A — MongoDB local (instalado en el mismo servidor):
MONGODB_URI=mongodb://127.0.0.1:27017/autofondo
# Opción B — MongoDB Atlas (recomendado para producción sin servidor propio):
# MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/autofondo?retryWrites=true&w=majority

# Modelo IA para eliminación de fondo: small | medium | large
# small = más rápido, large = mejor calidad (costo mayor en Cloud Run)
IMGLY_MODEL=small

# Clave de administrador para crear códigos de acceso (POST /api/v1/access)
# ¡CAMBIAR en producción! Si no se define, usa el valor hardcodeado 'af-admin-2025'
ADMIN_KEY=af-admin-2025

